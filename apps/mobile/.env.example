# Where the Next.js app is deployed. Native has no origin to be relative to, so
# @notch/core needs this to build absolute API URLs.
#
# Leave it EMPTY for local development. The app then derives the host from the
# Expo dev server it was loaded from and talks to port 3000 there, which is what
# makes a physical phone work: "localhost" on a device means the device itself,
# and the Mac's LAN address changes between networks. Start the web app with
#   npm run dev --workspace web -- --hostname 0.0.0.0
# so it listens on the LAN rather than loopback only.
#
# Set it to the deployed URL for TestFlight and release builds.
EXPO_PUBLIC_API_BASE_URL=

# Same Clerk instance as the web app.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
